# Fallback for environments where the inventory cannot be generated from
# Terraform state (terraform not installed on the control node).
# Copy to generated.ini and fill in the IPs manually:
#   cp hosts.ini.example generated.ini

[master]
master-1 ansible_host=192.168.122.50

[workers]
worker-1 ansible_host=192.168.122.51
worker-2 ansible_host=192.168.122.52

[all:vars]
ansible_user=ubuntu
ansible_ssh_private_key_file=~/.ssh/id_ed25519
